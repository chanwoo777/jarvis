# Jarvis settings. Everything here is optional; no API key is needed.

# What Jarvis calls you, e.g. sir, ma'am, boss, or your first name. Blank = no title.
JARVIS_CALL_ME=

# The AI model, run locally by Ollama. qwen3.5:2b is the fastest on a laptop.
# Smarter but slower: qwen3.5:4b (also installed). Smartest, slowest (needs ~8 GB free RAM): qwen3.5:9b
OLLAMA_MODEL=qwen3.5:2b

# Voice: any Microsoft neural voice name. en-GB-RyanNeural is a British butler voice.
JARVIS_VOICE=en-GB-RyanNeural

# Speech recognition model: tiny.en, base.en, small.en (bigger = more accurate, slower).
# Use base / small (no ".en") together with WHISPER_LANGUAGE=ko to speak Korean.
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# How sure the wake word detector must be (0-1). Lower it if Jarvis doesn't hear you,
# raise it if Jarvis wakes up by accident.
WAKE_THRESHOLD=0.5

# Long-term memory: a private GitHub repo (owner/name). Blank = remember only until Jarvis closes.
JARVIS_MEMORY_REPO=chanwoo777/jarvis-memory

# The website that shows Jarvis, and whether to open it when Jarvis starts (yes/no).
JARVIS_WEBSITE=https://chanwoo777.github.io/jarvis/
JARVIS_OPEN_WEBSITE=yes

# Model for detailed questions, thought through in the background.
DEEP_MODEL=qwen3.5:4b
